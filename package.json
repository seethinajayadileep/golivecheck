{
  "name": "golivecheck-agent",
  "version": "1.0.0",
  "description": "Testing agent: E2E, API, accessibility, and safe security — allowlisted and read-only.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seethinajayadileep/golivecheck.git"
  },
  "homepage": "https://github.com/seethinajayadileep/golivecheck#readme",
  "bugs": {
    "url": "https://github.com/seethinajayadileep/golivecheck/issues"
  },
  "keywords": [
    "testing",
    "playwright",
    "accessibility",
    "security",
    "mcp",
    "e2e"
  ],
  "bin": {
    "golivecheck": "dist/cli.js",
    "golivecheck-agent": "dist/cli.js"
  },
  "files": [
    "dist",
    "examples",
    "action.yml",
    "SKILL.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "demo": "node scripts/demo.mjs",
    "start:demo": "node examples/demo-site/server.mjs",
    "test": "vitest run",
    "golivecheck": "tsx src/cli.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@axe-core/playwright": "^4.10.2",
    "playwright": "^1.55.0",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
